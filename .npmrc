# @cursor/sdk resolves cursorsandbox via platform-package-locator: walk from
# argv[1]/execPath looking for node_modules/@cursor/sdk-<platform>-<arch>/bin/.
# Without public hoist, pnpm keeps the optional platform package only under
# .pnpm/.../node_modules/@cursor/, so isSandboxHelperSupported always fails.
public-hoist-pattern[]=@cursor/sdk-*
