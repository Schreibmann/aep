{
  "name": "@aep/runtime-cursor",
  "version": "0.0.0",
  "private": true,
  "description": "Cursor Agent SDK adapter package (sole AI runtime for AEP v1)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:offline": "node --experimental-strip-types ./scripts/validate-offline.mts",
    "validate:auth": "node --experimental-strip-types ./scripts/validate-auth.mts",
    "validate:live": "node --experimental-strip-types ./scripts/validate-live.mts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aep/domain": "workspace:*",
    "@aep/runtime-contracts": "workspace:*",
    "@aep/security": "workspace:*",
    "@cursor/sdk": "1.3.1"
  }
}
