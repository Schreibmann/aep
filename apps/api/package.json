{
  "name": "@aep/api",
  "version": "0.0.0",
  "private": true,
  "description": "Authenticated loopback-only AEP local API",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "aep-api": "./bin/aep-api.mjs"
  },

  "scripts": {
    "start": "node --experimental-strip-types ./src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aep/application": "workspace:*",
    "@aep/domain": "workspace:*"
  }
}
